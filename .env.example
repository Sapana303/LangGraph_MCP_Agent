# LLM used by the LangGraph agent
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=qwen/qwen3-32b,llama-3.3-70b-versatile
LLM_PROVIDER=groq
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Web search
TAVILY_API_KEY=

# Existing Optics RAG FastAPI service. Start it before using RAG queries.
OPTICS_RAG_API_URL=http://127.0.0.1:8000

# Filesystem MCP tool may only list directories below this path.
#FILESYSTEM_ROOT=.
