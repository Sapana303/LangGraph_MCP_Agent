# LLM used by the LangGraph agent
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
LLM_PROVIDER=groq
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optics RAG model downloads used by the combined Docker Compose stack
OPTICS_EMBED_MODEL=nomic-embed-text
OPTICS_VISION_MODEL=qwen2.5vl:3b
OPTICS_DEMO_MODE=false
# Web search
TAVILY_API_KEY=

# Used by the local, non-Docker development setup. Compose uses its internal optics-api service.
OPTICS_RAG_API_URL=http://127.0.0.1:8000

# Filesystem MCP tool may only list directories below this path.
#FILESYSTEM_ROOT=.
